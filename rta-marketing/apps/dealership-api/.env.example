# Local API. Copy to .env; never commit the real file.
NODE_ENV=development
HOST=0.0.0.0
PORT=5000
LOG_LEVEL=debug
TRUST_PROXY=false
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Neon pooled URL for API traffic; direct URL for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=verify-full
DATABASE_MIGRATION_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=verify-full
DATABASE_POOL_MAX=5
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_CONNECT_TIMEOUT_MS=5000

# Amazon SQS. Local credentials come from `aws configure --profile rta-local`.
QUEUE_PROVIDER=sqs
SQS_INTEGRATION_ENABLED=false
AWS_REGION=ap-south-1
AWS_PROFILE=rta-local
# Optional showcase/reference value. Required only when SQS_INTEGRATION_ENABLED=true.
# SQS_SCRAPE_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/ACCOUNT_ID/rta-scrape-jobs
SCRAPING_STACK_API_URL=http://localhost:4000
# Must match the scraping API's SCRAPE_TRIGGER_TOKEN. Server-only; never use VITE_.
SCRAPING_STACK_API_TOKEN=replace_with_the_scraping_api_trigger_token
QUEUE_OUTBOX_POLL_MS=5000
QUEUE_OUTBOX_BATCH_SIZE=10

# Private employee documents. The bucket must block public access.
S3_DOCUMENT_BUCKET=rta-private-documents-ACCOUNT_ID
DOCUMENT_UPLOAD_MAX_BYTES=10000000
DOCUMENT_URL_TTL_SECONDS=300

# Generate independently with: openssl rand -base64 48
SESSION_SECRET=replace_with_at_least_48_random_characters
CSRF_SECRET=replace_with_a_different_48_character_secret
SESSION_COOKIE_NAME=rta_session
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

# Used only by `npm run db:seed`; choose unique passwords with 14+ characters.
SEED_OPERATOR_EMAIL=operator@example.com
SEED_OPERATOR_PASSWORD=replace_with_a_unique_long_password
SEED_LIVE_SOURCES=false
# Creates a clearly labelled portfolio workspace with admin, employee,
# virtual-assistant and recruiter accounts plus deterministic sample records.
SEED_DEMO_DATA=true
SEED_DEMO_PASSWORD=replace_with_a_different_long_demo_password
SEED_RECRUITER_EMAIL=recruiter.demo@rta.local

REQUEST_BODY_LIMIT=32kb
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
SCRAPE_RATE_LIMIT_WINDOW_MS=3600000
SCRAPE_RATE_LIMIT_MAX=20
DEMO_MODE=true
DEFAULT_SCRAPE_MODE=fixture
ALLOW_LIVE_SCRAPING=true
# Server-only one-click recruiter demo login. Must match the seeded recruiter account.
DEMO_RECRUITER_EMAIL=recruiter.demo@rta.local
DEMO_RECRUITER_PASSWORD=replace_with_the_same_seed_demo_password

# Brevo HTTPS transactional email. Never expose these through VITE_*.
BREVO_API_KEY=replace_with_brevo_api_key
EMAIL_FROM=verified-sender@example.com
EMAIL_FROM_NAME=RTA Automotive Group
DEALERSHIP_WEB_URL=http://localhost:5173
SCRAPING_WEB_URL=http://localhost:5174
# Optional; without this, applicant confirmation still works but no admin email is sent.
ADMIN_NOTIFICATION_EMAIL=admin@example.com
