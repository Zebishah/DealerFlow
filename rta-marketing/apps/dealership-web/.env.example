# Browser-safe values only. Never place database, AWS, or session secrets here.
VITE_API_URL=http://localhost:5000/api/v1
# The demo login is executed server-side; no password belongs in Vercel/browser env.
# VITE_API_URL=https://rta-dealership-api.onrender.com/api/v1

# Vercel deployments automatically use the same-origin /rta-api gateway.
# For a custom frontend domain on Vercel, enable that gateway explicitly:
# VITE_API_SAME_ORIGIN=true
# VITE_API_URL remains the direct API URL for local/non-proxied deployments.
