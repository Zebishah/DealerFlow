# Local SQS worker. Lambda receives equivalent values in its configuration.
NODE_ENV=development
LOG_LEVEL=debug
TZ=America/Toronto
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=require
DATABASE_POOL_MAX=2
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_CONNECT_TIMEOUT_MS=5000
AWS_REGION=ap-south-1
AWS_PROFILE=rta-local
SQS_SCRAPE_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/ACCOUNT_ID/rta-scrape-jobs

# Keep false while parser fixtures and source permissions are being verified.
LIVE_SCRAPING_ENABLED=false
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=600
SQS_MAX_MESSAGES=1
WORKER_CONCURRENCY=1
SCRAPE_JOB_TIMEOUT_MS=540000
BROWSER_NAVIGATION_TIMEOUT_MS=60000
BROWSER_HEADLESS=true
BROWSER_DISABLE_SANDBOX=false
BROWSER_EXECUTABLE_PATH=
SCRAPE_ARTIFACT_DIR=/tmp/rta-scraper
SCRAPE_SCREENSHOT_ON_ERROR=false
SOURCE_MIN_DELAY_MS=1500
SCRAPE_MAX_PAGES_PER_SOURCE=20
SCRAPE_MAX_LISTINGS_PER_SOURCE=500
