# Worker runtime
NODE_ENV=development
LOG_LEVEL=debug
TZ=America/Toronto

# PostgreSQL and Redis must point to the same services as the API.
DATABASE_URL=postgresql://rta_user:rta_password@localhost:5432/rta
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=rta
SCRAPE_QUEUE_NAME=scrape-runs

# fixture: deterministic local/public demo data
# live: controlled real-source browser acquisition
SCRAPE_MODE=fixture
WORKER_CONCURRENCY=2
SOURCE_MAX_CONCURRENT_PAGES=1
SOURCE_MIN_DELAY_MS=1500
SCRAPE_MAX_ATTEMPTS=3
SCRAPE_BACKOFF_MS=5000
SCRAPE_BACKOFF_JITTER_MS=1000
SCRAPE_JOB_TIMEOUT_MS=180000
BROWSER_NAVIGATION_TIMEOUT_MS=60000
BROWSER_HEADLESS=true
# Leave empty to use Puppeteer's managed browser.
BROWSER_EXECUTABLE_PATH=
SCRAPE_ARTIFACT_DIR=/tmp/rta-scraper
SCRAPE_SCREENSHOT_ON_ERROR=false

# Source switches provide an immediate operational kill switch.
SOURCE_AUTOTRADER_ENABLED=true
SOURCE_AUTOPLANET_ENABLED=true
SOURCE_HUMBERVIEW_ENABLED=true
SOURCE_YORKDALE_ENABLED=true

# Safety limits
SCRAPE_MAX_PAGES_PER_SOURCE=20
SCRAPE_MAX_LISTINGS_PER_SOURCE=500
