{
  "name": "rta-platform-api",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "worker:dev": "tsx watch --env-file=.env.worker.local src/worker/local.ts",
    "worker:once": "tsx --env-file=.env.worker.local src/worker/local.ts --once",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --env-file=.env.test --import tsx --test src/*.test.ts src/**/*.test.ts",
    "test:coverage": "node --env-file=.env.test --import tsx --test --experimental-test-coverage src/*.test.ts src/**/*.test.ts"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "vehicle-intelligence",
    "sqs",
    "postgresql",
    "scraping"
  ],
  "license": "UNLICENSED",
  "description": "RTA vehicle intelligence API and SQS ingestion worker",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/client-sqs": "^3.1125.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@sparticuz/chromium": "149.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "puppeteer-core": "25.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.163",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
