# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=5000
LOG_LEVEL=debug
TRUST_PROXY=false

# Public URLs and browser access
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# PostgreSQL
# Use a pooled connection for normal API traffic.
DATABASE_URL=postgresql://rta_user:rta_password@localhost:5432/rta
# Use a direct/non-pooled connection for migrations.
DATABASE_MIGRATION_URL=postgresql://rta_user:rta_password@localhost:5432/rta

# Redis and BullMQ
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=rta
SCRAPE_QUEUE_NAME=scrape-runs

# Server-managed session authentication
# Generate each secret independently: openssl rand -base64 48
SESSION_SECRET=replace_with_at_least_48_random_bytes
CSRF_SECRET=replace_with_a_different_48_byte_random_secret
SESSION_COOKIE_NAME=rta_session
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

# Initial operator account (consumed only by the explicit seed command)
SEED_OPERATOR_EMAIL=operator@example.com
SEED_OPERATOR_PASSWORD=replace_with_a_unique_strong_password

# Abuse protection
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
SCRAPE_RATE_LIMIT_WINDOW_MS=3600000
SCRAPE_RATE_LIMIT_MAX=5
REQUEST_BODY_LIMIT=32kb

# Demo behavior
DEMO_MODE=true
ALLOW_LIVE_SCRAPING=false
