NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=verify-full
# Set REDIS_URL for hosted Redis, for example rediss://:PASSWORD@HOST:PORT.
# Leave it commented locally to use the REDIS_HOST/REDIS_PORT fallback below.
# REDIS_URL=rediss://:PASSWORD@YOUR-REDIS-HOST:6380
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-long-random-password
API_PORT=4000
CORS_ORIGIN=https://your-vercel-domain.example
SCRAPE_TRIGGER_TOKEN=replace-with-a-32-plus-character-random-secret
SCRAPE_ACCESS_CODE=replace-with-a-16-plus-character-recruiter-code
SCRAPE_SESSION_TTL_SECONDS=28800
SCRAPE_AUTH_RATE_LIMIT_MAX=5
SCRAPER_USER_AGENT=RTA-Portfolio-Scraper/1.0 (+https://example.com/contact)
CRAWLEE_MEMORY_MBYTES=450
SCRAPE_DEFAULT_LIMIT=5
SCRAPE_MAX_LIMIT=10
WORKER_CONCURRENCY=1
MANUAL_SCRAPING_ONLY=true
SCRAPE_NAVIGATION_TIMEOUT_MS=20000
SCRAPE_SELECTOR_TIMEOUT_MS=8000
SCRAPE_JOB_TIMEOUT_MS=60000
# Must cover two worker attempts, the 5s retry backoff, and hand-off margin.
SCRAPE_LOCK_TTL_SECONDS=180
SCRAPE_RATE_LIMIT_WINDOW_MS=60000
SCRAPE_RATE_LIMIT_MAX=3
SCRAPER_SITES_JSON='[{"key":"pakwheels","name":"PakWheels","baseUrl":"https://www.pakwheels.com/used-cars/search/-/","engine":"cheerio","itemSelector":"li.classified-listing","titleSelector":"a.car-name.ad-detail-path","priceSelector":".price-details","linkSelector":"a.car-name.ad-detail-path","delayMs":2500,"maxConcurrency":1},{"key":"olx-pakistan","name":"OLX Pakistan","baseUrl":"https://www.olx.com.pk/cars_c84","engine":"playwright","itemSelector":"article","titleSelector":"[aria-label=Title] h2","priceSelector":"[aria-label=Price]","linkSelector":"a","delayMs":4500,"maxConcurrency":1},{"key":"demo-synthetic","name":"Demo Source (synthetic data)","baseUrl":"https://demo.synthetic.invalid","engine":"cheerio","itemSelector":"article","titleSelector":"h2","priceSelector":".price","linkSelector":"a","delayMs":0,"maxConcurrency":1}]'
